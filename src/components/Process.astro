---
import Container from "./Container.astro";

const steps = [
  {
    n: "01",
    title: "Visita técnica gratuita",
    desc: "Analizamos tu propiedad, detectamos puntos vulnerables y definimos la cobertura ideal sin costo ni compromiso.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11Zm0-8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>`,
  },
  {
    n: "02",
    title: "Diseño y cotización",
    desc: "Te entregamos una propuesta clara: equipos, ubicaciones y precio transparente. Sin letras chiquitas.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3M9 4a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-6 9 2 2 4-4"/>`,
  },
  {
    n: "03",
    title: "Instalación profesional",
    desc: "Técnicos certificados instalan y configuran todo: cámaras, grabador, red y tu app lista para usar.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.8 2.8-2-2 2.8-2.8Z"/>`,
  },
  {
    n: "04",
    title: "Soporte y mantenimiento",
    desc: "Te capacitamos en el uso del sistema y quedamos disponibles para soporte, ajustes y mantenimiento continuo.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18.4 12A6.4 6.4 0 0 0 12 5.6M5.6 12A6.4 6.4 0 0 0 12 18.4M12 8a4 4 0 0 1 0 8m0-8a4 4 0 0 0 0 8"/>`,
  },
];
---

<section id="proceso" class="scroll-mt-24 py-20 md:py-28" data-scan-section>
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-anim-group data-anim="up">
      <span data-anim class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-900 dark:bg-white/5 dark:text-cyanx-300">
        Cómo trabajamos
      </span>
      <h2 data-anim class="mt-4 text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">
        Tu seguridad instalada en 4 pasos
      </h2>
      <p data-anim class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        Un proceso simple y transparente, de la primera llamada a la tranquilidad total.
      </p>
    </div>

    <div class="relative mt-16">
      <!-- Línea conectora (desktop) -->
      <div class="absolute left-0 right-0 top-8 hidden h-px bg-slate-200 dark:bg-white/10 lg:block">
        <div data-scan-progress class="h-full origin-left bg-gradient-to-r from-brand-700 to-cyanx-500" style="transform: scaleX(0)"></div>
      </div>

      <div class="grid gap-10 lg:grid-cols-4" data-anim-group data-anim="up">
        {
          steps.map((step) => (
            <div data-anim class="relative text-center lg:text-left">
              <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl border border-slate-100 bg-white text-brand-900 shadow-soft dark:border-white/10 dark:bg-slate-900 dark:text-cyanx-300 lg:mx-0">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={step.icon} />
              </div>
              <span class="mt-5 block font-mono text-sm font-bold text-cyanx-600 dark:text-cyanx-400">PASO {step.n}</span>
              <h3 class="mt-1 text-lg font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{step.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</section>

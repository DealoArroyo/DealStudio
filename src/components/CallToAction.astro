---
import Container from "./Container.astro";
---

<section id="contacto" class="scroll-mt-24 py-20 md:py-28">
  <Container>
    <div
      class="relative overflow-hidden rounded-[2.5rem] border border-white/10 bg-gradient-to-br from-brand-900 via-brand-950 to-brand-900 px-6 py-16 text-center shadow-2xl shadow-brand-900/30 md:px-12 md:py-20"
      data-anim-group
      data-anim="up"
    >
      <div aria-hidden="true" class="grid-tech absolute inset-0 opacity-40"></div>
      <div aria-hidden="true" class="absolute -left-24 -top-24 h-72 w-72 rounded-full bg-cyanx-500/20 blur-3xl"></div>
      <div aria-hidden="true" class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-brand-500/30 blur-3xl"></div>

      <div class="relative mx-auto max-w-2xl">
        <div data-anim class="mx-auto mb-6 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-cyanx-200 ring-1 ring-inset ring-white/15">
          <span class="rec-dot h-2 w-2 rounded-full bg-live"></span>
          Cotización gratuita · Respuesta inmediata
        </div>

        <h2 data-anim class="text-3xl font-extrabold text-white md:text-5xl">
          Da el primer paso hacia tu
          <span class="bg-gradient-to-r from-cyanx-300 to-white bg-clip-text text-transparent"> tranquilidad.</span>
        </h2>

        <p data-anim class="mx-auto mt-5 max-w-lg text-lg text-slate-300">
          Agenda tu visita técnica gratuita hoy mismo. Un asesor analizará tu propiedad y te dará el mejor plan de videovigilancia.
        </p>

        <div data-anim class="mt-9 flex flex-wrap justify-center gap-4">
          <a
            href="https://wa.me/524425573314?text=Hola%20DealStudio%2C%20quiero%20agendar%20una%20visita%20t%C3%A9cnica%20gratuita"
            target="_blank"
            rel="noopener"
            class="group flex h-13 items-center justify-center gap-2 rounded-full bg-white px-8 py-3.5 font-bold text-brand-900 shadow-lg transition hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.437-9.884 9.888-9.884a9.82 9.82 0 016.988 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
            Cotizar por WhatsApp
          </a>
          <a
            href="tel:+524425573314"
            class="flex h-13 items-center justify-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-3.5 font-bold text-white backdrop-blur transition hover:scale-105 active:scale-95"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.4-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg>
            Llámanos
          </a>
        </div>

        <p data-anim class="mt-6 text-sm text-slate-400">Sin compromiso · Atención en Querétaro y zona metropolitana</p>
      </div>
    </div>
  </Container>
</section>

---
import Container from "./Container.astro"
---

<div class="relative overflow-hidden" id="home">
    <div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-30">
        <div class="blur-[120px] h-64 bg-gradient-to-br from-blue-600 to-sky-400 dark:from-blue-700"></div>
        <div class="blur-[120px] h-48 bg-gradient-to-r from-cyan-400 to-indigo-300 dark:to-blue-900"></div>
    </div>

    <Container>
        <div class="relative pt-40 ml-auto">
            <div class="lg:w-2/3 text-center mx-auto">
                <div class="mb-8 flex justify-center">
                    <span class="rounded-full bg-blue-50 dark:bg-blue-900/20 px-4 py-1.5 text-sm font-medium text-bluedsc dark:text-blue-300 ring-1 ring-inset ring-blue-700/10">
                        Innovación y Seguridad para tu Empresa
                    </span>
                </div>

                <h1 class="text-gray-900 text-balance dark:text-white font-extrabold text-5xl md:text-6xl xl:text-7xl leading-tight">
                    Impulsamos tu éxito y <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 to-sky-400 dark:from-blue-300 dark:to-blue-100">blindamos tu futuro.</span>
                </h1>
                
                <p class="mt-8 text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
                    En <strong>DealStudio</strong> unificamos el poder del <strong>software estratégico</strong> con la protección de la <strong>videovigilancia avanzada</strong>. Creamos el entorno digital y físico que su empresa necesita para evolucionar.
                </p>

                <div class="mt-12 flex flex-wrap justify-center gap-y-4 gap-x-6">
                    <a
                      href="https://wa.me/4425573314"
                      class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:bg-bluedsc before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max shadow-lg shadow-blue-900/20"
                    >
                      <span class="relative text-base font-semibold text-white">Iniciar Proyecto</span>
                    </a>
                    <a
                      href="/#features"
                      class="relative flex h-12 w-full items-center justify-center px-8 before:absolute before:inset-0 before:rounded-full before:border before:border-gray-200 dark:before:border-gray-700 before:bg-gray-50 dark:before:bg-gray-800 before:transition before:duration-300 hover:before:scale-105 active:duration-75 active:before:scale-95 sm:w-max"
                    >
                      <span class="relative text-base font-semibold text-bluedsc dark:text-white">Explorar Servicios</span>
                    </a>
                </div>

                <div class="hidden mt-20 py-8 border-t border-gray-100 dark:border-gray-800 sm:grid grid-cols-3 gap-12">
                    <div class="text-left group">
                        <div class="mb-4 inline-block p-2 rounded-xl bg-blue-50 dark:bg-blue-900/20 group-hover:bg-bluedsc transition-colors duration-300">
                             <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-bluedsc group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <h6 class="text-lg font-bold text-gray-800 dark:text-white">Confianza y Blindaje</h6>
                        <p class="mt-2 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Protección robusta para sus activos digitales y físicos con tecnología de alta gama.</p>
                    </div>

                    <div class="text-left group">
                        <div class="mb-4 inline-block p-2 rounded-xl bg-blue-50 dark:bg-blue-900/20 group-hover:bg-bluedsc transition-colors duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-bluedsc group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <h6 class="text-lg font-bold text-gray-800 dark:text-white">Soporte Continuo</h6>
                        <p class="mt-2 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Acompañamiento experto y capacitación para el dominio total de sus herramientas.</p>
                    </div>

                    <div class="text-left group">
                        <div class="mb-4 inline-block p-2 rounded-xl bg-blue-50 dark:bg-blue-900/20 group-hover:bg-bluedsc transition-colors duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-bluedsc group-hover:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                        <h6 class="text-lg font-bold text-gray-800 dark:text-white">Crecimiento Escalable</h6>
                        <p class="mt-2 text-gray-500 dark:text-gray-400 text-sm leading-relaxed">Soluciones modulares diseñadas para expandirse al ritmo de su visión empresarial.</p>
                    </div>
                </div>
            </div>
        </div>
    </Container>
</div>
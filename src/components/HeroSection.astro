---
import Container from "./Container.astro";
---

<section class="relative overflow-hidden pt-32 pb-16 md:pt-40 lg:pb-24" id="inicio">
  <!-- Fondos decorativos -->
  <div aria-hidden="true" class="grid-tech absolute inset-0 -z-10"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 grid grid-cols-2 -space-x-52 opacity-40 dark:opacity-30">
    <div class="h-56 bg-gradient-to-br from-brand-600 to-cyanx-400 blur-[120px] dark:from-brand-700"></div>
    <div class="h-40 bg-gradient-to-r from-cyanx-400 to-brand-300 blur-[120px] dark:to-brand-900"></div>
  </div>

  <Container>
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8" data-scroll-out>
      <!-- Columna de texto -->
      <div class="text-center lg:text-left" data-anim-group data-anim="up">
        <span
          data-anim
          class="inline-flex items-center gap-2 rounded-full border border-brand-200/70 bg-brand-50 px-4 py-1.5 text-sm font-medium text-brand-900 dark:border-white/10 dark:bg-white/5 dark:text-cyanx-300"
        >
          <span class="relative flex h-2 w-2">
            <span class="rec-dot h-2 w-2 rounded-full bg-live"></span>
          </span>
          Videovigilancia profesional en Querétaro
        </span>

        <h1
          data-anim
          class="mt-6 text-balance text-4xl font-extrabold leading-[1.05] text-slate-900 dark:text-white sm:text-5xl xl:text-6xl"
        >
          Cámaras de seguridad que
          <span class="bg-gradient-to-r from-brand-700 to-cyanx-500 bg-clip-text text-transparent dark:from-cyanx-300 dark:to-brand-200">
            vigilan por ti, 24/7.
          </span>
        </h1>

        <p data-anim class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300 lg:mx-0">
          Instalamos sistemas de <strong>CCTV y videovigilancia</strong> con acceso desde tu celular,
          visión nocturna a color y alertas inteligentes. Protege tu casa o negocio con tecnología de alta gama.
        </p>

        <div data-anim class="mt-8 flex flex-wrap justify-center gap-4 lg:justify-start">
          <a
            href="https://wa.me/524425573314?text=Hola%20DealStudio%2C%20quiero%20cotizar%20c%C3%A1maras%20de%20seguridad"
            target="_blank"
            rel="noopener"
            class="group relative flex h-13 items-center justify-center gap-2 rounded-full bg-brand-900 px-7 py-3.5 font-semibold text-white shadow-lg shadow-brand-900/25 transition hover:scale-105 active:scale-95"
          >
            Cotización gratis
            <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a
            href="/#servicios"
            class="flex h-13 items-center justify-center rounded-full border border-slate-200 bg-white/60 px-7 py-3.5 font-semibold text-slate-800 backdrop-blur transition hover:scale-105 active:scale-95 dark:border-white/10 dark:bg-white/5 dark:text-white"
          >
            Ver servicios
          </a>
        </div>

        <!-- Micro prueba social -->
        <dl data-anim class="mt-10 grid max-w-xs grid-cols-2 gap-4 border-t border-slate-200/70 pt-6 dark:border-white/10 mx-auto lg:mx-0">
          <div>
            <dt class="text-2xl font-bold text-slate-900 dark:text-white"><span data-count="24" data-count-suffix="/7">24/7</span></dt>
            <dd class="text-xs text-slate-500 dark:text-slate-400">Monitoreo remoto</dd>
          </div>
          <div>
            <dt class="text-2xl font-bold text-slate-900 dark:text-white"><span data-count="4" data-count-suffix="K">4K</span></dt>
            <dd class="text-xs text-slate-500 dark:text-slate-400">Resolución máxima</dd>
          </div>
        </dl>
      </div>

      <!-- Columna visual: monitor CCTV en vivo -->
      <div class="relative" data-anim data-anim-delay="0.15">
        <div
          class="relative overflow-hidden rounded-3xl border border-white/10 bg-slate-900 p-2 shadow-2xl shadow-brand-900/30"
          data-parallax="0.12"
        >
          <!-- Barra superior del monitor -->
          <div class="flex items-center justify-between rounded-t-2xl bg-slate-950 px-4 py-2.5 text-xs text-slate-400">
            <div class="flex items-center gap-2">
              <span class="rec-dot h-2.5 w-2.5 rounded-full bg-live"></span>
              <span class="font-semibold tracking-wide text-white">EN VIVO</span>
            </div>
            <span class="font-mono">CÁM 01 · ENTRADA PRINCIPAL</span>
            <span id="cctv-clock" class="font-mono">--:--:--</span>
          </div>

          <!-- Feed -->
          <div class="relative aspect-[4/3] overflow-hidden rounded-b-2xl">
            <img
              src="https://images.unsplash.com/photo-1558002038-1055907df827?auto=format&fit=crop&q=80&w=1000"
              alt="Vista de cámara de seguridad monitoreando la entrada de un negocio en Querétaro"
              class="h-full w-full object-cover"
              loading="eager"
              width="1000"
              height="750"
            />
            <!-- Tinte night-vision + viñeta -->
            <div class="absolute inset-0 bg-gradient-to-b from-brand-950/10 via-transparent to-brand-950/60"></div>
            <div class="absolute inset-0 mix-blend-overlay bg-cyanx-500/10"></div>

            <!-- Línea de escaneo -->
            <div class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-cyanx-400/30 to-transparent scanline"></div>

            <!-- Caja de detección de movimiento -->
            <div class="absolute left-[18%] top-[42%] h-[38%] w-[34%] rounded border-2 border-cyanx-400 shadow-[0_0_20px_rgba(56,207,255,0.4)]">
              <span class="absolute -top-6 left-0 rounded bg-cyanx-500 px-1.5 py-0.5 text-[10px] font-bold text-slate-950">
                MOVIMIENTO · 98%
              </span>
              <span class="absolute -bottom-1 -left-1 h-2 w-2 rounded-full bg-cyanx-400"></span>
              <span class="absolute -bottom-1 -right-1 h-2 w-2 rounded-full bg-cyanx-400"></span>
            </div>

            <!-- HUD inferior -->
            <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between text-[11px] font-mono text-white/90">
              <span class="rounded bg-black/40 px-2 py-0.5 backdrop-blur-sm">● REC</span>
              <span class="rounded bg-black/40 px-2 py-0.5 backdrop-blur-sm">2160p · 30fps</span>
            </div>
          </div>
        </div>

        <!-- Tarjeta flotante: alerta -->
        <div
          data-anim
          data-anim-delay="0.5"
          class="absolute -left-4 bottom-8 hidden max-w-[220px] rounded-2xl border border-slate-100 bg-white/90 p-4 shadow-xl backdrop-blur-md dark:border-white/10 dark:bg-slate-800/90 sm:block"
        >
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-live/10 text-live">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900 dark:text-white">Alerta enviada</p>
              <p class="text-xs text-slate-500 dark:text-slate-400">Notificación a tu celular</p>
            </div>
          </div>
        </div>

        <!-- Tarjeta flotante: online -->
        <div
          data-anim
          data-anim-delay="0.65"
          class="absolute -right-3 top-6 hidden items-center gap-2 rounded-full border border-slate-100 bg-white/90 px-4 py-2 shadow-xl backdrop-blur-md dark:border-white/10 dark:bg-slate-800/90 sm:flex"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute inline-flex h-full w-full rounded-full bg-emerald-400 radar-ping opacity-70"></span>
            <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
          </span>
          <span class="text-xs font-semibold text-slate-700 dark:text-slate-200">4 cámaras en línea</span>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  // Reloj en vivo del monitor CCTV
  const clock = document.getElementById("cctv-clock");
  if (clock) {
    const tick = () =>
      (clock.textContent = new Date().toLocaleTimeString("es-MX", { hour12: false }));
    tick();
    setInterval(tick, 1000);
  }
</script>

---
import Container from "./Container.astro";
---

<footer class="py-20 md:py-40 bg-gray-50 dark:bg-gray-900">
  <Container>
    <div class="m-auto md:w-10/12 lg:w-8/12 xl:w-6/12">
      <div class="flex flex-wrap justify-between gap-10 md:gap-20">

        <!-- Navegación -->
        <div class="w-full sm:w-7/12">
          <div class="grid grid-cols-2 gap-y-4 gap-x-12 text-gray-600 dark:text-gray-300">
            <a href="#" class="transition hover:text-primary">Inicio</a>
            <a href="#" class="transition hover:text-primary">Características</a>
            <a href="#" class="transition hover:text-primary">Soluciones</a>
            <a href="#" class="transition hover:text-primary">Reseñas</a>
            <a href="#" class="transition hover:text-primary">Contacto</a>
          </div>
        </div>

        <!-- Información secundaria -->
        <div class="w-full sm:w-5/12 space-y-4 text-center sm:text-left">
          <span class="block text-gray-500 dark:text-gray-400">
            DealStudio &copy; <span id="year"></span>
          </span>

          <div class="flex flex-wrap justify-center gap-6 sm:justify-start text-gray-600 dark:text-white">
            <a href="/Terminos_de_uso.pdf" download class="font-medium hover:text-primary">Términos de uso</a>
            <a href="/Politicas_de_privacidad.pdf" download class="font-medium hover:text-primary">Política de privacidad</a>
          </div>

          <span class="block text-gray-500 dark:text-gray-400">
            ¿Necesitas ayuda?
            <a href="https://wa.me/4424220140" class="font-semibold text-gray-600 dark:text-white hover:text-primary">
              Contáctanos
            </a>
          </span>
        </div>

      </div>
    </div>
  </Container>
</footer>

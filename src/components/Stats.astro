---
import Container from "./Container.astro";

const stats = [
  { value: 8, suffix: "+", label: "Años de experiencia" },
  { value: 500, suffix: "+", label: "Cámaras instaladas" },
  { value: 100, suffix: "%", label: "Clientes satisfechos" },
  { value: 24, suffix: "h", label: "Respuesta a soporte" },
];

const sectors = [
  "Casas y residencias",
  "Comercios y tiendas",
  "Oficinas",
  "Bodegas e industria",
  "Fraccionamientos",
  "Restaurantes",
  "Consultorios",
  "Estacionamientos",
];
---

<section class="py-20 md:py-24">
  <Container>
    <div
      class="relative overflow-hidden rounded-[2.5rem] bg-brand-950 px-6 py-14 text-white shadow-2xl shadow-brand-900/30 md:px-14"
      data-scan-section
    >
      <div aria-hidden="true" class="grid-tech absolute inset-0 opacity-40"></div>
      <div aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-cyanx-500/20 blur-3xl"></div>

      <div class="relative">
        <!-- Contadores -->
        <div class="grid grid-cols-2 gap-8 border-b border-white/10 pb-12 md:grid-cols-4" data-anim-group data-anim="zoom">
          {
            stats.map((s) => (
              <div data-anim class="text-center">
                <div class="font-display text-4xl font-extrabold text-white md:text-5xl">
                  <span data-count={s.value} data-count-suffix={s.suffix}>0{s.suffix}</span>
                </div>
                <p class="mt-2 text-sm text-slate-300">{s.label}</p>
              </div>
            ))
          }
        </div>

        <!-- Sectores -->
        <div class="mt-12 flex flex-col items-center gap-8 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-md text-center lg:text-left" data-anim data-anim-group>
            <h2 data-anim class="text-2xl font-bold md:text-3xl">Protegemos todo tipo de espacios</h2>
            <p data-anim class="mt-3 text-slate-300">
              Adaptamos cada instalación al tamaño y las necesidades de tu propiedad, en Querétaro y zona metropolitana.
            </p>
          </div>
          <div class="flex flex-wrap justify-center gap-2.5 lg:max-w-md lg:justify-end" data-anim-group data-anim="fade">
            {
              sectors.map((sector) => (
                <span data-anim class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-slate-200 backdrop-blur transition hover:border-cyanx-400/40 hover:text-white">
                  {sector}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

---
import Container from "./Container.astro";

const waBase = "https://wa.me/524425573314?text=";

const mxn = (n: number) =>
  n.toLocaleString("es-MX", {
    style: "currency",
    currency: "MXN",
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  });

const paquetes = [
  {
    nombre: "Hogar Seguro",
    linea: "Paquete Esencial",
    marca: "HiLook",
    imagen: "/images/productos/paquete-esencial.webp",
    badge: "Mejor precio",
    badgeStyle: "bg-emerald-500 text-white",
    featured: false,
    precioLista: 6499,
    precioPromo: 5499,
    descripcion:
      "La opción perfecta para tranquilidad y monitoreo confiable 24/7 sin desajustar tu presupuesto. Respaldado por una marca líder.",
    chips: ["4 cámaras", "Full HD 1080p", "500GB", "Interior/Exterior"],
    features: [
      "4 cámaras Full HD 1080p (2 MP) con imagen clara y nítida",
      "Visión nocturna infrarroja hasta 20 metros",
      "Disco duro de 500GB optimizado para videovigilancia",
      "Monitoreo remoto desde tu celular, sin rentas mensuales",
      "Resistente a lluvia y polvo (apta para exterior)",
    ],
    wa: "Hola DealStudio, me interesa el Paquete Esencial Hogar Seguro (Full HD 1080p)",
  },
  {
    nombre: "Ultra Visión",
    linea: "Paquete Avanzado",
    marca: "ASECAM",
    imagen: "/images/productos/paquete-avanzado.webp",
    badge: "El más vendido",
    badgeStyle: "bg-cyanx-500 text-slate-950",
    featured: true,
    precioLista: 8499,
    precioPromo: 6999,
    descripcion:
      "Para quienes requieren un nivel superior de detalle. Más del doble de resolución y un grabador preparado para crecer.",
    chips: ["4 cámaras", "5 MP Super HD", "Audio", "1TB", "DVR 8 canales"],
    features: [
      "4 cámaras de 5 Megapíxeles (calidad Super HD) para máximo detalle",
      "Micrófono integrado: escucha lo que sucede alrededor",
      "DVR de 8 canales expandible (agrega hasta 4 cámaras más)",
      "Disco duro de 1TB para almacenar más días de grabación",
      "Visión nocturna Smart IR y notificaciones en tu celular",
    ],
    wa: "Hola DealStudio, me interesa el Paquete Avanzado Ultra Visión (5MP con audio)",
  },
  {
    nombre: "Smart IA",
    linea: "Paquete Premium",
    marca: "Dahua",
    imagen: "/images/productos/paquete-premium.webp",
    badge: "Inteligencia Artificial",
    badgeStyle: "bg-brand-900 text-white dark:bg-white dark:text-brand-900",
    featured: false,
    precioLista: 10499,
    precioPromo: 8999,
    descripcion:
      "Seguridad al siguiente nivel. Algoritmos que distinguen personas y vehículos, ignorando mascotas, hojas o lluvia. Cero falsas alarmas.",
    chips: ["4 cámaras", "1080p + IA", "1TB", "H.265+"],
    features: [
      "Detección inteligente: te notifica solo ante personas o vehículos reales",
      "4 cámaras Full HD 1080p con alta sensibilidad luminosa",
      "1TB + compresión H.265+ (graba muchos más días en menos espacio)",
      "Visión nocturna inteligente con ajuste automático de luz",
      "Búsqueda rápida de eventos por humano o vehículo",
    ],
    wa: "Hola DealStudio, me interesa el Paquete Premium Smart IA (con Inteligencia Artificial)",
  },
];
---

<section id="paquetes" class="scroll-mt-24 py-20 md:py-28">
  <Container>
    <div class="mx-auto max-w-2xl text-center" data-anim-group data-anim="up">
      <span data-anim class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3 py-1 text-sm font-semibold text-brand-900 dark:bg-white/5 dark:text-cyanx-300">
        Paquetes
      </span>
      <h2 data-anim class="mt-4 text-3xl font-bold text-slate-900 dark:text-white md:text-4xl">
        Elige el kit ideal para tu propiedad
      </h2>
      <p data-anim class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        Todos incluyen <strong class="text-slate-800 dark:text-white">instalación profesional</strong>, cableado estético, configuración en tu celular y garantía.
      </p>
    </div>

    <div class="mt-16 grid items-stretch gap-6 lg:grid-cols-3" data-anim-group data-anim="up">
      {
        paquetes.map((p) => (
          <article
            data-anim
            class={`group relative flex flex-col rounded-3xl border bg-white p-6 shadow-soft transition-all duration-300 hover:-translate-y-1 hover:shadow-soft-lg dark:bg-slate-900/60 ${
              p.featured
                ? "border-cyanx-400 ring-2 ring-cyanx-400/40 lg:-translate-y-3 lg:scale-[1.03] dark:border-cyanx-400/60"
                : "border-slate-100 hover:border-cyanx-300/60 dark:border-white/10"
            }`}
          >
            {/* Badge */}
            <div class="absolute -top-3 left-1/2 -translate-x-1/2">
              <span class={`inline-flex items-center gap-1 rounded-full px-3 py-1 text-xs font-bold shadow-md ${p.badgeStyle}`}>
                {p.featured && (
                  <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                )}
                {p.badge}
              </span>
            </div>

            {/* Imagen del producto */}
            <div class="mt-3 overflow-hidden rounded-2xl bg-white p-3 ring-1 ring-slate-100 dark:bg-white dark:ring-white/10">
              <img
                src={p.imagen}
                alt={`Kit de cámaras de seguridad ${p.marca} — ${p.linea} ${p.nombre}`}
                class="mx-auto aspect-square w-full object-contain transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                width="600"
                height="600"
              />
            </div>

            {/* Encabezado */}
            <div class="mt-6">
              <div class="flex items-center justify-between">
                <p class="text-xs font-semibold uppercase tracking-wider text-cyanx-600 dark:text-cyanx-400">{p.linea}</p>
                <span class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-semibold text-slate-600 dark:bg-white/10 dark:text-slate-300">{p.marca}</span>
              </div>
              <h3 class="mt-1 text-2xl font-bold text-slate-900 dark:text-white">{p.nombre}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{p.descripcion}</p>
            </div>

            {/* Precio */}
            <div class="mt-5 rounded-2xl border border-slate-100 bg-slate-50/70 p-4 dark:border-white/10 dark:bg-white/5">
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-extrabold text-slate-900 dark:text-white">{mxn(p.precioPromo)}</span>
                <span class="text-sm text-slate-400 line-through decoration-live/70">{mxn(p.precioLista)}</span>
              </div>
              <div class="mt-1.5 flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-live/10 px-2 py-0.5 text-xs font-bold text-live">
                  <span class="rec-dot h-1.5 w-1.5 rounded-full bg-live"></span>
                  Promoción · ahorras {mxn(p.precioLista - p.precioPromo)}
                </span>
              </div>
            </div>

            {/* Chips de specs */}
            <div class="mt-5 flex flex-wrap gap-2">
              {p.chips.map((chip) => (
                <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-300">
                  {chip}
                </span>
              ))}
            </div>

            {/* Features */}
            <ul class="mt-6 space-y-3 border-t border-slate-100 pt-6 dark:border-white/10">
              {p.features.map((f) => (
                <li class="flex gap-3 text-sm text-slate-600 dark:text-slate-300">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-cyanx-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>

            {/* CTA */}
            <div class="mt-8 pt-2">
              <a
                href={waBase + encodeURIComponent(`${p.wa} por ${mxn(p.precioPromo)} (precio de promoción, antes ${mxn(p.precioLista)}). ¿Me pueden dar más información?`)}
                target="_blank"
                rel="noopener"
                class={`flex h-12 w-full items-center justify-center gap-2 rounded-full font-semibold transition hover:scale-[1.03] active:scale-95 ${
                  p.featured
                    ? "bg-brand-900 text-white shadow-lg shadow-brand-900/25 dark:bg-cyanx-500 dark:text-slate-950"
                    : "border border-brand-900/15 bg-brand-50 text-brand-900 dark:border-white/10 dark:bg-white/5 dark:text-white"
                }`}
              >
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.437-9.884 9.888-9.884a9.82 9.82 0 016.988 2.898 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/></svg>
                Cotizar este paquete
              </a>
              <p class="mt-3 text-center text-xs text-slate-400">Instalación y garantía incluidas</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-center text-sm text-slate-500 dark:text-slate-400" data-anim>
      ¿No sabes cuál elegir? <a href="https://wa.me/524425573314" target="_blank" rel="noopener" class="font-semibold text-brand-900 underline underline-offset-2 dark:text-cyanx-300">Cuéntanos tu caso</a> y te recomendamos el ideal.
    </p>
  </Container>
</section>
